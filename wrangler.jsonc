{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nickymyny",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Collector list (/collect). Create with `wrangler d1 create nickymyny-collectors`
  // and paste the database_id it prints. See docs/collector-list.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nickymyny-collectors",
      "database_id": "REPLACE-WITH-DATABASE-ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
