{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nickymyny",
	// Nicky@artkom.be's Cloudflare account (the CLI login also sees other accounts).
	"account_id": "bb71cafd4dc9e5c77fd43aed4320eda7",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Collector list (/collect). See docs/collector-list.md.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nickymyny-collectors",
			"database_id": "28b2dbed-446a-477d-9950-4940358c7ec8",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
